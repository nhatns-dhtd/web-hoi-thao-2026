# Copy sang .env rồi điền giá trị thật. KHÔNG commit file .env.

# --- Database (Vercel Postgres / Neon) ---
POSTGRES_URL=

# --- Auth ---
# Secret dùng để ký session token. Tối thiểu 32 ký tự, sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Đổi secret này sẽ làm mọi phiên đang đăng nhập bị đăng xuất.
AUTH_SECRET=

# Tài khoản admin đầu tiên. Chỉ dùng khi bảng users còn RỖNG — seed sẽ hash mật khẩu
# trước khi lưu. Bảng users đã có dữ liệu thì đổi mật khẩu bằng:
#   npm run set-admin-password -- <username> <password>
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=afce@hnmu.edu.vn
